<%- include('partials/header') %>

<div class="grade-hero">
  <div class="container">
    <div class="grade-hero-badge"><%= gradeNumber %></div>
    <h1>Welcome to <%= gradeName %></h1>
    <p><%= tagline %></p>
  </div>
</div>

<section class="section">
  <div class="container">

    <% if (subjectSections.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">📄</div>
        <div class="empty-title">No learning materials available yet.</div>
        <p>The admin will add real papers for <%= gradeName %> soon — check back later.</p>
      </div>
    <% } else { %>
      <% subjectSections.forEach(function(sec) { %>
        <div class="grade-section-block">
          <div class="section-head">
            <div>
              <h2><%= sec.subject %></h2>
              <p class="section-sub"><%= sec.materials.length %> item<%= sec.materials.length === 1 ? '' : 's' %> available</p>
            </div>
          </div>

          <div class="materials-grid">
            <% sec.materials.forEach(function(m) { %>
              <div class="material-card">
                <div class="material-card-icon">📄</div>
                <div class="material-card-body">
                  <div class="material-card-badges">
                    <% if (m.subject) { %><span class="badge"><%= m.subject %></span><% } %>
                    <% if (m.year) { %><span class="badge badge-muted"><%= m.year %></span><% } %>
                    <span class="badge badge-muted"><%= m.materialType %></span>
                  </div>
                  <h3 class="material-card-title"><%= m.title %></h3>
                  <% if (m.description) { %>
                    <p class="material-card-desc"><%= m.description %></p>
                  <% } %>
                  <div class="material-card-meta">
                    <% if (m.term) { %><span><%= m.term %></span><% } %>
                    <% if (m.topic) { %><span><%= m.topic %></span><% } %>
                    <span><%= m.fileSize || '' %></span>
                    <span>👁 <%= (m.views || 0).toLocaleString() %> views</span>
                    <span>⬇ <%= (m.downloads || 0).toLocaleString() %> downloads</span>
                  </div>
                </div>
                <div class="material-card-actions">
                  <a href="/materials/<%= m.id %>/view" class="btn btn-primary">View</a>
                  <a href="/materials/<%= m.id %>/download" class="btn btn-outline">Download</a>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      <% }); %>
    <% } %>

  </div>
</section>

<%- include('partials/footer') %>
