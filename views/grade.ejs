<%- include('partials/header') %>

<div class="grade-hero">
  <div class="container">
    <div class="grade-hero-badge"><%= gradeNumber %></div>
    <h1>Welcome to <%= gradeName %></h1>
    <p><%= tagline %></p>
  </div>
</div>

<section class="section">
  <div class="container">

    <% if (subjectSections.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h8l4 4v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/><path d="M14 3v4h4"/><path d="M8 13h8"/><path d="M8 17h5"/></svg></div>
        <div class="empty-title">No learning materials available yet.</div>
        <p>The admin will add real papers for <%= gradeName %> soon — check back later.</p>
      </div>
    <% } else { %>
      <div class="card-grid">
        <% subjectSections.forEach(function(sec) { %>
          <a class="card subject-card" href="/grade/<%= gradeNumber %>/<%= encodeURIComponent(sec.subject) %>">
            <div class="subject-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 5.5V20.5"/><path d="M20 18H6.5A2.5 2.5 0 0 0 4 20.5"/></svg></div>
            <h3><%= sec.subject %></h3>
            <div class="subject-meta"><%= gradeName %></div>
            <div class="subject-footer">
              <span class="badge"><%= sec.pastPaperCount %> paper<%= sec.pastPaperCount === 1 ? '' : 's' %></span>
              <span class="section-link">View subject &rarr;</span>
            </div>
          </a>
        <% }); %>
      </div>
    <% } %>

  </div>
</section>

<%- include('partials/footer') %>
