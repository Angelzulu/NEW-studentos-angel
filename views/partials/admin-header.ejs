<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | <%= siteName %> Admin</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin-body">
  <div class="admin-layout">
    <div class="admin-sidebar-backdrop"></div>

    <aside class="admin-sidebar">
      <a href="/admin" class="brand">
        <span class="brand-mark">SOS</span>
        <span>Student<span style="color:var(--color-primary);">OS</span></span>
      </a>
      <div class="admin-sidebar-tag">Admin Panel</div>

      <nav class="admin-nav">
        <a href="/admin" class="<%= activeNav === 'dashboard' ? 'active' : '' %>">
          <span class="nav-icon">&#9635;</span> Dashboard
        </a>
        <a href="/admin/students" class="<%= activeNav === 'students' ? 'active' : '' %>">
          <span class="nav-icon">&#128101;</span> Students
        </a>
        <a href="/admin/teachers" class="<%= activeNav === 'teachers' ? 'active' : '' %>">
          <span class="nav-icon">&#127891;</span> Teachers
        </a>
        <a href="/admin/grades" class="<%= activeNav === 'grades' ? 'active' : '' %>">
          <span class="nav-icon">&#128200;</span> Grades
        </a>
        <a href="/admin/subjects" class="<%= activeNav === 'subjects' ? 'active' : '' %>">
          <span class="nav-icon">&#128218;</span> Subjects
        </a>
        <a href="/admin/content" class="<%= activeNav === 'content' ? 'active' : '' %>">
          <span class="nav-icon">&#128228;</span> Content
        </a>
        <a href="/admin/announcements" class="<%= activeNav === 'announcements' ? 'active' : '' %>">
          <span class="nav-icon">&#128227;</span> Announcements
        </a>
        <a href="/admin/reports" class="<%= activeNav === 'reports' ? 'active' : '' %>">
          <span class="nav-icon">&#128202;</span> Reports
        </a>
        <a href="/admin/settings" class="<%= activeNav === 'settings' ? 'active' : '' %>">
          <span class="nav-icon">&#9881;</span> Settings
        </a>
      </nav>

      <div class="admin-sidebar-footer">
        <a href="/">&larr; Back to site</a>
        <form method="POST" action="/admin/logout" style="margin:.5rem 0 0;">
          <button type="submit" style="background:none;border:none;cursor:pointer;color:#e53e3e;font-size:.85rem;padding:0;text-decoration:underline;">Sign out</button>
        </form>
      </div>
    </aside>

    <div class="admin-main">
      <header class="admin-topbar">
        <div class="admin-topbar-left">
          <button class="sidebar-toggle" aria-label="Toggle sidebar">&#9776;</button>
          <div>
            <h1><%= title %></h1>
            <div class="breadcrumb">Admin / <%= title %></div>
          </div>
        </div>
        <div class="admin-user">
          <div class="admin-avatar"><%= (adminUser && adminUser.displayName) ? adminUser.displayName[0].toUpperCase() : 'A' %></div>
          <span><%= (adminUser && adminUser.displayName) ? adminUser.displayName : 'Admin' %>
            <% if (adminUser && adminUser.role) { %>
              <small style="display:block;font-size:.7rem;color:#aaa;text-transform:capitalize;"><%= adminUser.role %></small>
            <% } %>
          </span>
          <form method="POST" action="/admin/logout" style="margin:0;">
            <button type="submit" title="Sign out" style="background:none;border:none;cursor:pointer;color:#e53e3e;font-size:1.1rem;padding:.2rem .4rem;margin-left:.4rem;" aria-label="Sign out">&#x23FB;</button>
          </form>
        </div>
      </header>

      <main class="admin-content">
