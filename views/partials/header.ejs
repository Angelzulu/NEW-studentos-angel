<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <% var pageTitle = (typeof metaTitle !== 'undefined' && metaTitle) ? metaTitle : (title + ' | ' + siteName); %>
  <% var pageDesc  = (typeof metaDescription !== 'undefined' && metaDescription) ? metaDescription : ('Student OS - past papers, exam information and study resources for Zambian students.'); %>
  <% var pageUrl   = (typeof canonicalUrl !== 'undefined' && canonicalUrl) ? canonicalUrl : (typeof siteUrl !== 'undefined' ? siteUrl + currentPath : undefined); %>

  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDesc %>" />
  <% if (typeof robotsMeta !== 'undefined' && robotsMeta) { %>
    <meta name="robots" content="<%= robotsMeta %>" />
  <% } %>
  <% if (pageUrl) { %>
    <link rel="canonical" href="<%= pageUrl %>" />
  <% } %>

  <!-- Open Graph (social sharing / rich previews — same info as above) -->
  <meta property="og:site_name" content="<%= siteName %>" />
  <meta property="og:title" content="<%= pageTitle %>" />
  <meta property="og:description" content="<%= pageDesc %>" />
  <meta property="og:type" content="website" />
  <% if (pageUrl) { %><meta property="og:url" content="<%= pageUrl %>" /><% } %>

  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a href="/" class="brand">
        <span class="brand-mark">SOS</span>
        <span class="brand-name">Student<span>OS</span></span>
      </a>

      <nav class="main-nav">
        <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a>
        <a href="/papers" class="<%= currentPath === '/papers' ? 'active' : '' %>">Past Papers</a>
        <a href="/subjects" class="<%= currentPath === '/subjects' ? 'active' : '' %>">Subjects</a>
        <a href="/exams" class="<%= currentPath === '/exams' ? 'active' : '' %>">Exam Info</a>
        <a href="/resources" class="<%= currentPath === '/resources' ? 'active' : '' %>">Resources</a>
        <a href="/contact" class="<%= currentPath === '/contact' ? 'active' : '' %>">Contact</a>
      </nav>

      <div class="header-actions">
        <button class="nav-toggle" aria-label="Toggle navigation">&#9776;</button>
      </div>
    </div>
  </header>
