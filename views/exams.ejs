<%- include('partials/header') %>

<div class="page-header">
  <h1 class="page-title">Exam Information</h1>
  <p class="page-sub">
    ECZ exam dates, registration info, rules and notices for Grade 7,
    Grade 9 and Grade 12 students in Zambia.
  </p>
</div>

<% if (examInfo.length === 0) { %>
  <div class="site-empty-state">
    <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M16 2.5v4M8 2.5v4M3 9.5h18"/></svg></div>
    <div class="empty-title">No exam information yet</div>
    <div class="empty-sub">Check back closer to the examination period.</div>
  </div>
<% } else { %>
  <div class="announce-list">
    <% examInfo.forEach(function(e) { %>
      <div class="announce-item">
        <div class="announce-header">
          <h2 class="announce-title"><%= e.title %></h2>
          <div class="announce-meta">
            <span class="badge badge-muted"><%= e.category %></span>
            <span class="badge"><%= e.grade %></span>
          </div>
        </div>
        <div class="announce-body"><%= e.content.replace(/\n/g, '<br>') %></div>
      </div>
    <% }); %>
  </div>
<% } %>

<%- include('partials/footer') %>
