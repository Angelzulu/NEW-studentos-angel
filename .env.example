# Student OS — Environment Configuration Template
#
# INSTRUCTIONS:
# 1. Copy this file to .env for local development.
# 2. Fill in your real values below.
# 3. NEVER commit .env to git — it contains secret credentials.
# 4. Add .env to .gitignore (it should already be there).

# ── Cloudflare R2 Storage ────────────────────────────────────────────────────
R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_here
R2_SECRET_ACCESS_KEY=your_secret_key_here
R2_BUCKET_NAME=studentos-pdfs
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Session Security ─────────────────────────────────────────────────────────
# Generate a random 32+ character string for SESSION_SECRET.
SESSION_SECRET=generate_a_long_random_string_at_least_32_characters

# ── Admin Authentication ─────────────────────────────────────────────────────
# Generate ADMIN_PASSWORD_HASH using bcryptjs; never store plaintext passwords.
ADMIN_PASSWORD_HASH=replace_with_your_bcrypt_hash

# ── Failed Admin Login Email Alerts ──────────────────────────────────────────
# For Gmail, enable 2-Step Verification and create an App Password in Google
# Account security settings. Use the 16-character App Password, not your
# normal Gmail password. Store these values as Render environment variables.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_sending_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password
SECURITY_ALERT_EMAIL=Angelzuluitx@gmail.com
# Optional: the sender address shown in the email. Defaults to SMTP_USER.
# SECURITY_ALERT_FROM=your_sending_gmail_address@gmail.com

# ── Node Environment ─────────────────────────────────────────────────────────
# Set by Render automatically in production.
# NODE_ENV=production
