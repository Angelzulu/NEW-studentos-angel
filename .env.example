# Student OS — Environment Configuration Template
# 
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your real values below
# 3. NEVER commit .env to git — it contains secret credentials
# 4. Add .env to .gitignore (it should already be there)

# ── Cloudflare R2 Storage ────────────────────────────────────────────────────
# To get these values:
# 1. Go to Cloudflare Dashboard → R2 → API Tokens
# 2. Create a new token with read/write permissions
# 3. Get your Account ID from the R2 overview page
# 4. Set R2_PUBLIC_URL to your public bucket domain (e.g., https://pub-xxxx.r2.dev)
#    NOT the dashboard URL (https://dash.cloudflare.com/...)
#
# R2_ENDPOINT is always: https://{ACCOUNT_ID}.r2.cloudflarestorage.com

R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_here
R2_SECRET_ACCESS_KEY=your_secret_key_here
R2_BUCKET_NAME=studentos-pdfs

# R2_ENDPOINT format: https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# R2_PUBLIC_URL should be your public bucket domain, NOT the dashboard
# Examples:
#   - Public bucket domain: https://pub-abc123def456.r2.dev
#   - Custom domain: https://pdfs.example.com
# DO NOT USE: https://dash.cloudflare.com/...
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Session Security ─────────────────────────────────────────────────────────
# Generate a random 32+ character string for SESSION_SECRET:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=generate_a_long_random_string_at_least_32_characters

# ── Admin Authentication ────────────────────────────────────────────────────
# Generate ADMIN_PASSWORD_HASH:
#   node -e "require('bcryptjs').hash('YOUR_PASSWORD', 12).then(h => console.log(h))"
# Replace YOUR_PASSWORD with your actual admin password
ADMIN_PASSWORD_HASH=$2b$12$FGtNASpMPoZ5QaaXLrt8QuxxIbD.2Mq4.paHKXXMgbh25qpD1WfsK

# ── Node Environment ─────────────────────────────────────────────────────────
# Set by Render/Vercel automatically in production
# NODE_ENV=production
